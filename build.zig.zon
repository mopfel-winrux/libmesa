.{
    .name = .libmesa,
    .version = "0.0.1",
    .fingerprint = 0xa484debe1276f816,
    .minimum_zig_version = "0.15.2",
    .dependencies = .{
        //  same pin as vere/ext/urcrypt; we only build the blake3,
        //  chacha and ed25519 subset
        .urcrypt = .{
            .url = "https://github.com/urbit/urcrypt/archive/a4c229e9380636ace36325b6c8fe04eaee32a2ef.tar.gz",
            .hash = "N-V-__8AAFJ8TACpTWfH-dcjaICx9KJRA2pZhQ1A7VtF968Z",
        },
        //  for libmesa-host only; the same wrappers vere uses
        .libuv = .{ .path = "./ext/libuv", .lazy = true },
        .curl = .{ .path = "./ext/curl", .lazy = true },
        .sqlite = .{
            .url = "https://www.sqlite.org/2024/sqlite-autoconf-3460100.tar.gz",
            .hash = "N-V-__8AAJ-VwwDaAVSvGsN1z0uZTm2aAeq1ZO5tulayl2Cy",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "include",
        "src",
        "vendor",
        "ext",
        "LICENSE.txt",
    },
}
